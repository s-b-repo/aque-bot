# ─────────────────────────────────────────────────────────────
# NEXUS·SMC — environment configuration
# Copy to `.env` and adjust. A single .env feeds BOTH:
#   • the Vite dashboard (only VITE_* vars are exposed to the browser)
#   • the Node API server (loaded via `node --env-file-if-exists=.env`)
# ─────────────────────────────────────────────────────────────

# ── Dashboard (browser) ──
# Base URL the dashboard uses to reach the API server.
# Leave as localhost for local use; set to the server's address in production.
VITE_API_URL=http://127.0.0.1:3001

# ── API server (Node) ──
# Port the API server listens on.
PORT=3001

# Bind address. 127.0.0.1 (default) = loopback only — safest.
# Set to 0.0.0.0 ONLY if the EA / dashboard run on another machine, and then
# you SHOULD also set NEXUS_API_TOKEN below and firewall the port.
BIND_HOST=127.0.0.1

# Shared machine secret for state-changing endpoints (/api/claim, /api/trades,
# /api/heartbeat) AND for /api/executor-config (which returns decrypted exchange
# keys). REQUIRED for any non-loopback / Docker deployment — without it the
# executor-config endpoint refuses non-loopback callers. The MT4/MT5 EA and the
# executor must use the same value (ApiKey / NEXUS_API_TOKEN).
NEXUS_API_TOKEN=

# Master encryption passphrase for exchange secrets at rest. If set, the AES key
# is DERIVED from this (never written to disk), so the data volume alone cannot
# decrypt your keys. Strongly recommended before storing live exchange keys.
MASTER_KEY=

# Server-side confidence floor: signals below this are never published.
MIN_CONFIDENCE=60

# ── Universal executor (replaces the MT4/MT5 EA; runs via CCXT) ──
# Where the executor reaches the API (use http://server:3001 in docker-compose).
# API_URL=http://127.0.0.1:3001

# Broker: 'paper' (default, simulated fills on live prices — NO keys, NO risk)
#         'ccxt'  (real exchange execution)
EXECUTOR_BROKER=paper

# ⚠ LIVE TRADING — only when EXECUTOR_BROKER=ccxt. false = exchange sandbox/testnet.
# Set true ONLY after you have tested on the sandbox. This spends REAL money.
EXECUTOR_LIVE=false

# CCXT exchange (any of 100+: binance, bybit, okx, kraken, coinbase, ...).
EXCHANGE_ID=binance
# 'spot' (long only) or 'swap'/'future' (enables shorting SELL signals).
EXCHANGE_TYPE=spot
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_API_PASSWORD=
QUOTE_CURRENCY=USDT

# Risk (executor) — ported EA defaults; tune to taste.
# NOTE: these can also be set from the dashboard's 🤖 Bot Settings (GUI), which
# overrides these env defaults at runtime. Exchange keys set in the GUI are
# encrypted at rest; setting them here is fine for headless deployments.
RISK_PERCENT=1
MAX_RISK_DOLLARS=20
MAX_OPEN_TRADES=3
MAX_DAILY_LOSS_PERCENT=5
MAX_CONSECUTIVE_LOSSES=4
DYNAMIC_RISK=true     # smart sizing: scale by confidence, de-risk losses/drawdown
# Signal->exchange symbol map (data-only markets like Nasdaq are simply omitted).
SYMBOL_MAP=BTCUSD=BTC/USDT,EURUSDT=EUR/USDT
